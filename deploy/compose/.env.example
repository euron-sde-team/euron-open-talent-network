# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
TALENT_JWT_SECRET=replace-with-output-of-make-env
TALENT_REFRESH_SECRET=replace-with-output-of-make-env
TALENT_DEMO_PASSWORD=replace-with-output-of-make-env
# 32 random bytes, base64 (openssl rand -base64 32): encrypts stored TOTP secrets.
TALENT_TOTP_ENCRYPTION_KEY=replace-with-output-of-make-env

# Optional overrides (host ports and names)
# TALENT_PRODUCT_NAME=Euron Open Talent
# TALENT_LOG_LEVEL=info
# TALENT_WEB_PORT=3520
# TALENT_API_PORT=5016
# TALENT_PG_PORT=5482
# TALENT_REDIS_PORT=6419
# TALENT_MAILPIT_PORT=8036
# TALENT_SMTP_PORT=1036
# TALENT_FLOCI_PORT=4587
# TALENT_STUB_PORT=5109
